# ── Alert Relay — minimal Node.js image ────────────────────────────────────────
# Standalone webhook-to-LINE-Notify forwarder. Zero npm dependencies; uses only
# Node built-in http/https. Separate from the API container so alerts fire even
# when the API is down.

FROM node:22-alpine

WORKDIR /app

COPY server/services/alert-relay.js .

USER node

EXPOSE 3003

CMD ["node", "alert-relay.js"]
