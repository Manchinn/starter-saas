# =============================================================================
# Production endpoint — set to the public HTTPS origin.
# Cloudflare Tunnel provides TLS, so this is always https://<your-domain>
# =============================================================================
CLIENT_URL=https://app.your-domain.com
WEB_PORT=8080

# PostgreSQL container and API connection
POSTGRES_DB=saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=replace-with-one-long-random-password
DB_NAME=saas
DB_USER=saas
DB_PASSWORD=replace-with-one-long-random-password

# Application security — use long, random, unique secrets
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# =============================================================================
# Cookie Secure: 'auto' mirrors the request scheme.
# With Cloudflare Tunnel (X-Forwarded-Proto: https) the cookie gets the Secure flag.
# =============================================================================
COOKIE_SECURE=auto

# =============================================================================
# Trust 1 reverse-proxy hop (cloudflared → nginx).
# 0 = no proxy (localhost dev); 1 = one trusted proxy; true = all.
# =============================================================================
TRUST_PROXY=1

# Branding
APP_NAME=SaaS
VITE_APP_NAME=SaaS

# ── LINE login (LIFF) — PoC ────────────────────────────────────────────────
# LINE Messaging API Channel ID (LINE Developers Console → LINE Login app).
# POST /api/auth/line verifies the LIFF idToken against this channel before
# creating/logging-in the user. Leave blank → /api/auth/line returns 501.
LINE_CHANNEL_ID=
# LINE LIFF app ID (LINE Console → LIFF). Referenced server-side; the client
# uses it via liff.init({ liffId }). Must match the console app.
LINE_LIFF_ID=
# Single-org PoC: the organization UUID that owns the LIFF app (NOT the LIFF
# ID). Injected into the client image at build time (compose.yaml web
# build-arg → VITE_LIFF_ORG_ID). Empty string disables the LIFF wiring.
VITE_LIFF_ORG_ID=

# ⚠️ .env.demo (PoC, host-local at /home/admin2/starter-saas-demo/.env.demo)
# is NOT committed and MUST hold real values for LINE_CHANNEL_ID / LINE_LIFF_ID
# / VITE_LIFF_ORG_ID — this example intentionally ships blanks.

# AES-256-GCM key (base64 32 bytes) that encrypts LINE channel secrets at rest.
# Needed only for the LINE admin connection API (LineConnection).
# LINE_CREDENTIAL_ENCRYPTION_KEY=

# Optional services
# Redis — enabled in production for shared cache, rate limiting, and
# multi-replica Socket.IO broadcast. Host is the Docker service name.
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
LOG_LEVEL=info
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# AI provider URLs must be reachable from the API container, not localhost.

# ── Monitoring ──────────────────────────────────────────────────────────────────
# LINE Notify token for health-down alerts.
# Generate at https://notify-bot.line.me/my/ → "Generate token".
LINE_NOTIFY_TOKEN=

# Log shipping to Loki (opt-in; start with compose --profile monitoring up -d).
# Set LOKI_ENABLED=true once Loki is running.
LOKI_ENABLED=false
LOKI_HOST=loki
LOKI_PORT=3100

# Uptime Kuma dashboard port (loopback, not exposed to internet)
UK_PORT=3001

# Grafana dashboard port (loopback) and admin credentials
GF_PORT=3002
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
