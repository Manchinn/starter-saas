# Local Docker-only origin. Set this to the exact public HTTPS origin before an external TLS proxy is introduced.
CLIENT_URL=http://127.0.0.1:8080
WEB_PORT=8080

# PostgreSQL container and API connection
POSTGRES_DB=saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=replace-with-one-long-random-password
DB_NAME=saas
DB_USER=saas
DB_PASSWORD=replace-with-one-long-random-password

# Application security
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=0

# Branding
APP_NAME=SaaS
VITE_APP_NAME=SaaS

# Optional services
REDIS_ENABLED=false
LOG_LEVEL=info
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# LINE_CREDENTIAL_ENCRYPTION_KEY=
# AI provider URLs must be reachable from the API container, not localhost.
