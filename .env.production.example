# =============================================================================
# Production endpoint — set to the public HTTPS origin.
# Cloudflare Tunnel provides TLS, so this is always https://<your-domain>
# =============================================================================
CLIENT_URL=https://app.your-domain.com
WEB_PORT=8080

# PostgreSQL container and API connection
POSTGRES_DB=saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=replace-with-one-long-random-password
DB_NAME=saas
DB_USER=saas
DB_PASSWORD=replace-with-one-long-random-password

# Application security — use long, random, unique secrets
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# =============================================================================
# Cookie Secure: 'auto' mirrors the request scheme.
# With Cloudflare Tunnel (X-Forwarded-Proto: https) the cookie gets the Secure flag.
# =============================================================================
COOKIE_SECURE=auto

# =============================================================================
# Trust 1 reverse-proxy hop (cloudflared → nginx).
# 0 = no proxy (localhost dev); 1 = one trusted proxy; true = all.
# =============================================================================
TRUST_PROXY=1

# Branding
APP_NAME=SaaS
VITE_APP_NAME=SaaS

# ── LINE login (LIFF) — PoC ────────────────────────────────────────────────
# ⚠️ CONFIG ALIGNMENT (#6): ตัวแปร 3 ตัวนี้ต้องตั้งให้ตรงกัน มิฉะนั้น LINE login
# จะล้มเหลว (401 ทุกครั้ง) และยากต่อดีบั๊ก ค่าแต่ละตัวต้องมาจาก LINE Developers
# console ตัวเดียวกัน (channel เดียว + LIFF app ตัวเดียวกัน):
#
#   LINE_CHANNEL_ID  (server)  — Messaging API Channel ID ของ LINE Login channel.
#                                ใช้เป็น OAuth client_id เพื่อ verify idToken ของ
#                                LIFF (POST /api/auth/line, config.line.channelId)
#                                พร้อม cross-check claim `aud` ให้ตรงกับ channel.
#                                ว่าง/ผิด → /api/auth/line ตอบ 501 (feature disabled).
#   VITE_LIFF_ORG_ID (client)  — ค่า LIFF ID ที่ client ส่งเข้า liff.init({ liffId })
#                                ใน flow login (useLineAuth.js). ถูก inject เข้า
#                                client bundle ตอน BUILD (compose.yaml web build-arg)
#                                → เปลี่ยนค่านี้ต้อง rebuild image ไม่งั้น bundle ยังมีค่าเก่า.
#                                ⚠️ ชื่อ "ORG_ID" ทำให้เข้าใจผิด — สำหรับ LINE-login PoC
#                                ค่านี้คือ LIFF ID (เช่น 2010854084-xxxx) ไม่ใช่ org UUID.
#   LINE_LIFF_ID     (server)  — LIFF app ID เดียวกัน เก็บไว้ฝั่ง server (config.line.liffId);
#                                ต้องตรงกับ VITE_LIFF_ORG_ID ที่ client ใช้.
#
# กฎ: LIFF app ที่ VITE_LIFF_ORG_ID / LINE_LIFF_ID อ้างถึง ต้องเป็น LIFF ตัวเดียวกับ
# channel ที่ LINE_CHANNEL_ID ชี้ เพราะ LIFF ผูกกับ channel ใน LINE Developers console.
# ถ้าตั้งไม่ตรง (เช่น liff.init ด้วย LIFF ID ของ channel อื่น หรือ aud ไม่ตรง channel)
# → LINE verify fail → 401. ยังมีข้อควรระวัง: ตัวแปร VITE_LIFF_ORG_ID ตัวเดียวถูกอ่าน
# สองแบบใน client build — flow login (liff.init({ liffId })) ต้องการค่าเป็น LIFF ID,
# ส่วน line-ordering module (client/src/modules/line/views/LiffOrdering.vue) อ่านเป็น
# organization UUID เพื่อเรียก /line/liff/:orgId/config. เลือกค่าเดียวที่ทำให้ทั้งสอง path
# ใช้งานได้ตามที่ต้องการ (ดู docs/production-runbook.md หัวข้อ "LINE login (PoC)").
LINE_CHANNEL_ID=
LINE_LIFF_ID=
VITE_LIFF_ORG_ID=

# ⚠️ .env.demo (PoC, host-local at /home/admin2/starter-saas-demo/.env.demo)
# is NOT committed and MUST hold the SAME real values as above for
# LINE_CHANNEL_ID / LINE_LIFF_ID / VITE_LIFF_ORG_ID — this example ships blanks.

# AES-256-GCM key (base64 32 bytes) that encrypts LINE channel secrets at rest.
# Needed only for the LINE admin connection API (LineConnection).
# LINE_CREDENTIAL_ENCRYPTION_KEY=

# Optional services
# Redis — enabled in production for shared cache, rate limiting, and
# multi-replica Socket.IO broadcast. Host is the Docker service name.
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
LOG_LEVEL=info
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# AI provider URLs must be reachable from the API container, not localhost.

# ── Monitoring ──────────────────────────────────────────────────────────────────
# LINE Notify token for health-down alerts.
# Generate at https://notify-bot.line.me/my/ → "Generate token".
LINE_NOTIFY_TOKEN=

# Log shipping to Loki (opt-in; start with compose --profile monitoring up -d).
# Set LOKI_ENABLED=true once Loki is running.
LOKI_ENABLED=false
LOKI_HOST=loki
LOKI_PORT=3100

# Uptime Kuma dashboard port (loopback, not exposed to internet)
UK_PORT=3001

# Grafana dashboard port (loopback) and admin credentials
GF_PORT=3002
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
