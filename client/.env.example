# Product display name embedded in the client build.
# Copy to client/.env (or set in the build environment) to override the SaaS default.
VITE_APP_NAME=SaaS

# Organization ID for LINE LIFF ordering (single-org deployment).
# Set to your organization UUID from the database.
VITE_LIFF_ORG_ID=

# Development API proxy target.
# VITE_API_TARGET=http://localhost:3000
